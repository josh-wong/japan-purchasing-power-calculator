{
  "name": "japan-purchasing-power-calculator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "rates:update": "node scripts/update-rates.mjs",
